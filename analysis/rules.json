{
  "version": "2.1",
  "description": "APKStudioAI 2.1 malware detection rules",
  "categories": {
    "spyware": {
      "name": "Spyware",
      "description": "Surveillance malware stealing personal data",
      "severity": "critical",
      "indicators": [
        "RECORD_AUDIO",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "READ_CONTACTS",
        "READ_SMS",
        "READ_CALL_LOG",
        "MediaProjection",
        "AccessibilityService",
        "getRunningTasks",
        "PackageManager"
      ],
      "min_matches": 3,
      "mitre_techniques": ["T1505.003", "T1614.001", "T1539", "T1538"]
    },
    "rat": {
      "name": "Remote Access Trojan (RAT)",
      "description": "Full device control with C2 communication",
      "severity": "critical",
      "indicators": [
        "Socket",
        "ServerSocket",
        "Runtime.exec",
        "ProcessBuilder",
        "DexClassLoader",
        "PathClassLoader",
        "Class.forName",
        "Method.invoke",
        "BIND_DEVICE_ADMIN",
        "BIND_ACCESSIBILITY_SERVICE",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE"
      ],
      "min_matches": 4,
      "mitre_techniques": ["T1040", "T1547.001", "T1505.001", "T1059"]
    },
    "trojan": {
      "name": "Trojan",
      "description": "Malware with overlay, package install, device admin abuse",
      "severity": "high",
      "indicators": [
        "SYSTEM_ALERT_WINDOW",
        "TYPE_SYSTEM_ALERT",
        "REQUEST_INSTALL_PACKAGES",
        "INSTALL_PACKAGES",
        "DEVICE_ADMIN",
        "DeviceAdminReceiver",
        "BIND_ACCESSIBILITY_SERVICE",
        "performGesture",
        "force-lock",
        "wipe-data",
        "reset-password"
      ],
      "min_matches": 3,
      "mitre_techniques": ["T1556.004", "T1505.001", "T1547.001"]
    },
    "banker": {
      "name": "Banking Trojan",
      "description": "Targets financial credentials via overlay and accessibility",
      "severity": "critical",
      "indicators": [
        "SYSTEM_ALERT_WINDOW",
        "AccessibilityService",
        "WebView",
        "loadUrl",
        "evaluateJavascript",
        "addJavascriptInterface",
        "getPackageName",
        "SharedPreferences",
        "Keystore",
        "Cipher",
        "BIND_ACCESSIBILITY_SERVICE",
        "TYPE_VIEW_TEXT_CHANGED"
      ],
      "min_matches": 3,
      "mitre_techniques": ["T1556.004", "T1056.001", "T1539"]
    },
    "dropper": {
      "name": "Dropper",
      "description": "Downloads and installs additional payloads",
      "severity": "high",
      "indicators": [
        "REQUEST_INSTALL_PACKAGES",
        "INSTALL_PACKAGES",
        "DownloadManager",
        "HttpURLConnection",
        "OkHttpClient",
        "FileOutputStream",
        "DexClassLoader",
        "PathClassLoader",
        "getAssets",
        "openRawResource",
        "pm install"
      ],
      "min_matches": 3,
      "mitre_techniques": ["T1505.001", "T1547.001", "T1105"]
    },
    "downloader": {
      "name": "Downloader",
      "description": "Fetches and executes additional code",
      "severity": "high",
      "indicators": [
        "DownloadManager",
        "HttpURLConnection",
        "OkHttpClient",
        "WebSocket",
        "Socket",
        "DexClassLoader",
        "PathClassLoader",
        "InMemoryDexClassLoader",
        "Class.forName",
        "defineClass",
        "loadClass"
      ],
      "min_matches": 3,
      "mitre_techniques": ["T1105", "T1059.001"]
    },
    "screen_capture": {
      "name": "Screen Capture",
      "description": "Captures screen content",
      "severity": "high",
      "indicators": [
        "MediaProjection",
        "createScreenCaptureIntent",
        "ImageReader",
        "acquireLatestImage",
        "Surface",
        "Canvas",
        "Bitmap",
        "BIND_ACCESSIBILITY_SERVICE",
        "getWindows"
      ],
      "min_matches": 2,
      "mitre_techniques": ["T1505.003"]
    },
    "keylogger": {
      "name": "Keylogger",
      "description": "Logs keystrokes and input",
      "severity": "high",
      "indicators": [
        "BIND_ACCESSIBILITY_SERVICE",
        "AccessibilityEvent",
        "TYPE_VIEW_TEXT_CHANGED",
        "TYPE_VIEW_CLICKED",
        "InputMethodService",
        "onKeyDown",
        "onKeyUp",
        "KeyEvent",
        "getText",
        "getContentDescription"
      ],
      "min_matches": 2,
      "mitre_techniques": ["T1056.001"]
    },
    "accessibility_abuse": {
      "name": "Accessibility Service Abuse",
      "description": "Abuses accessibility for automation/overlay",
      "severity": "high",
      "indicators": [
        "BIND_ACCESSIBILITY_SERVICE",
        "AccessibilityService",
        "canRetrieveWindowContent",
        "canPerformGestures",
        "FLAG_REQUEST_TOUCH_EXPLORATION_MODE",
        "FLAG_REQUEST_FILTER_KEY_EVENTS",
        "FLAG_REPORT_VIEW_IDS",
        "FLAG_RETRIEVE_INTERACTIVE_WINDOWS",
        "performGesture",
        "dispatchGesture",
        "click",
        "scrollForward",
        "scrollBackward",
        "setText"
      ],
      "min_matches": 3,
      "mitre_techniques": ["T1505.003", "T1056.001"]
    },
    "device_admin_abuse": {
      "name": "Device Admin Abuse",
      "description": "Abuses device admin for lock/wipe/policy",
      "severity": "critical",
      "indicators": [
        "DeviceAdminReceiver",
        "DevicePolicyManager",
        "BIND_DEVICE_ADMIN",
        "DEVICE_ADMIN",
        "force-lock",
        "reset-password",
        "wipe-data",
        "watch-login",
        "setPasswordQuality",
        "setPasswordMinimumLength",
        "lockNow",
        "wipeData",
        "setMaximumFailedPasswordsForWipe"
      ],
      "min_matches": 2,
      "mitre_techniques": ["T1547.001", "T1485", "T1490"]
    },
    "vpn_abuse": {
      "name": "VPN Service Abuse",
      "description": "Abuses VPN for traffic interception",
      "severity": "high",
      "indicators": [
        "VpnService",
        "BIND_VPN_SERVICE",
        "establish",
        "addRoute",
        "addAddress",
        "addDnsServer",
        "protect",
        "Socket",
        "DatagramSocket",
        "HttpURLConnection",
        "OkHttpClient"
      ],
      "min_matches": 2,
      "mitre_techniques": ["T1040"]
    },
    "overlay_attack": {
      "name": "Overlay Attack",
      "description": "Uses overlay for phishing/credential theft",
      "severity": "high",
      "indicators": [
        "SYSTEM_ALERT_WINDOW",
        "WindowManager",
        "TYPE_SYSTEM_ALERT",
        "TYPE_APPLICATION_OVERLAY",
        "addView",
        "updateViewLayout",
        "LayoutParams",
        "FLAG_NOT_FOCUSABLE",
        "FLAG_NOT_TOUCH_MODAL",
        "FLAG_WATCH_OUTSIDE_TOUCH"
      ],
      "min_matches": 2,
      "mitre_techniques": ["T1556.004"]
    },
    "sms_stealer": {
      "name": "SMS Stealer",
      "description": "Intercepts, reads, or sends SMS",
      "severity": "high",
      "indicators": [
        "SEND_SMS",
        "RECEIVE_SMS",
        "READ_SMS",
        "WRITE_SMS",
        "SmsManager",
        "sendTextMessage",
        "sendMultipartTextMessage",
        "onReceive",
        "SMS_RECEIVED",
        "abortBroadcast",
        "PDU",
        "getMessageBody",
        "getOriginatingAddress"
      ],
      "min_matches": 2,
      "mitre_techniques": ["T1538"]
    },
    "credential_theft": {
      "name": "Credential Theft",
      "description": "Steals credentials via various methods",
      "severity": "critical",
      "indicators": [
        "AccountManager",
        "getAccounts",
        "getAuthToken",
        "SharedPreferences",
        "PASSWORD",
        "USERNAME",
        "LOGIN",
        "CREDENTIAL",
        "WebView",
        "loadUrl",
        "evaluateJavascript",
        "addJavascriptInterface",
        "onPageFinished",
        "BIND_ACCESSIBILITY_SERVICE",
        "TYPE_VIEW_TEXT_CHANGED",
        "TYPE_WINDOW_CONTENT_CHANGED"
      ],
      "min_matches": 3,
      "mitre_techniques": ["T1539", "T1056.001", "T1556.004"]
    },
    "data_exfiltration": {
      "name": "Data Exfiltration",
      "description": "Collects and exfiltrates sensitive data",
      "severity": "high",
      "indicators": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "MANAGE_EXTERNAL_STORAGE",
        "READ_CONTACTS",
        "READ_SMS",
        "READ_CALL_LOG",
        "READ_CALENDAR",
        "HttpURLConnection",
        "OkHttpClient",
        "WebSocket",
        "Socket",
        "OutputStream",
        "FileOutputStream",
        "Firebase",
        "DatabaseReference",
        "Telegram",
        "bot",
        "api.telegram.org"
      ],
      "min_matches": 3,
      "mitre_techniques": ["T1539", "T1538", "T1041"]
    },
    "dynamic_code_loading": {
      "name": "Dynamic Code Loading",
      "description": "Loads code dynamically at runtime",
      "severity": "high",
      "indicators": [
        "DexClassLoader",
        "PathClassLoader",
        "InMemoryDexClassLoader",
        "loadClass",
        "defineClass",
        "Class.forName",
        "Method.invoke",
        "Field.set",
        "Constructor.newInstance",
        "DexFile",
        "loadDex",
        "getAssets",
        "openRawResource",
        "DownloadManager",
        "FileOutputStream"
      ],
      "min_matches": 2,
      "mitre_techniques": ["T1059.001", "T1105"]
    },
    "persistence": {
      "name": "Persistence",
      "description": "Maintains persistence across reboots",
      "severity": "high",
      "indicators": [
        "RECEIVE_BOOT_COMPLETED",
        "BOOT_COMPLETED",
        "QUICKBOOT_POWERON",
        "FOREGROUND_SERVICE",
        "startForeground",
        "DeviceAdminReceiver",
        "BIND_DEVICE_ADMIN",
        "BIND_ACCESSIBILITY_SERVICE",
        "JobScheduler",
        "WorkManager",
        "AlarmManager",
        "setExact",
        "setRepeating",
        "setInexactRepeating"
      ],
      "min_matches": 2,
      "mitre_techniques": ["T1547.001"]
    },
    "anti_analysis": {
      "name": "Anti-Analysis",
      "description": "Detects analysis/emulator/debugger/root",
      "severity": "medium",
      "indicators": [
        "Build.TYPE",
        "Build.FINGERPRINT",
        "Build.MODEL",
        "Build.MANUFACTURER",
        "Build.BRAND",
        "Build.DEVICE",
        "Build.PRODUCT",
        "goldfish",
        "generic",
        "emulator",
        "isDebuggerConnected",
        "Debug.isDebuggerConnected",
        "Trace.isTracing",
        "TracerPid",
        "ptrace",
        "Xposed",
        "Frida",
        "Substrate",
        "Cydia",
        "SU",
        "Superuser",
        "Magisk",
        "root",
        "checkSignature",
        "getPackageInfo",
        "SIGNATURE",
        "GET_SIGNATURES",
        "GET_PERMISSIONS"
      ],
      "min_matches": 2,
      "mitre_techniques": ["T1497", "T1027"]
    },
    "obfuscation": {
      "name": "Code Obfuscation",
      "description": "Code obfuscation to hinder analysis",
      "severity": "medium",
      "indicators": [
        "ProGuard",
        "proguard",
        "DexGuard",
        "dexguard",
        "StringEncryption",
        "ControlFlow",
        "Reflection",
        "ArithmeticObfuscation",
        "ControlFlowObfuscation"
      ],
      "min_matches": 1,
      "mitre_techniques": ["T1027"]
    },
    "hidden_payload": {
      "name": "Hidden Payload",
      "description": "Hidden/encrypted payload in assets/resources",
      "severity": "high",
      "indicators": [
        "assets/",
        "raw/",
        "res/raw/",
        "getAssets",
        "openRawResource",
        "DexFile",
        "loadDex",
        "defineClass",
        "Base64",
        "decode",
        "decodeBase64",
        "XOR",
        "AES",
        "Cipher",
        "SecretKeySpec",
        "IvParameterSpec",
        "encryption",
        "decryption"
      ],
      "min_matches": 2,
      "mitre_techniques": ["T1027", "T1105"]
    },
    "ransomware": {
      "name": "Ransomware",
      "description": "Encrypts files and demands ransom",
      "severity": "critical",
      "indicators": [
        "DeviceAdminReceiver",
        "wipe-data",
        "reset-password",
        "force-lock",
        "SYSTEM_ALERT_WINDOW",
        "Cipher",
        "AES",
        "RSA",
        "encrypt",
        "SecretKeySpec",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE"
      ],
      "min_matches": 3,
      "mitre_techniques": ["T1486", "T1547.001", "T1556.004"]
    }
  }
}